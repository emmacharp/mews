[Unit]
Description=Mews playlist builder
After=network.target

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/srv/mews
EnvironmentFile=/srv/mews/.env
ExecStart=/usr/bin/node /srv/mews/server.mjs
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
